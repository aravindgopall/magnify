# =============================================================================
# Hybrid Search Agent - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# EMBEDDING MODEL CONFIGURATION
# -----------------------------------------------------------------------------

# Embedding provider type: 'bge-m3' | 'local-bge-m3' | 'mock'
# Default: bge-m3 (uses BGE-M3 embeddings + BM25 hybrid search)
EMBEDDING_PROVIDER=bge-m3

# HuggingFace API key (required for BGE-M3 cloud, optional for local)
# Get your key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# Local BGE-M3 server URL (used when EMBEDDING_PROVIDER=local-bge-m3)
# Uses the FlagEmbedding library for best results
# Start the server with: python scripts/embedding_server.py
LOCAL_BGE_M3_URL=http://localhost:8002

# Embedding dimensions (BGE-M3 uses 1024)
EMBEDDING_DIMENSIONS=1024

# Embedding model name
EMBEDDING_MODEL=BAAI/bge-m3

# Device for local embedding server: 'cpu' | 'cuda'
EMBEDDING_DEVICE=cpu

# -----------------------------------------------------------------------------
# SYNTHESIS MODEL CONFIGURATION (for answer generation)
# -----------------------------------------------------------------------------

# Synthesis model for final answer generation
SYNTHESIS_MODEL=glm-latest
SYNTHESIS_PROVIDER=grid

# Flash model for query decomposition (faster, cheaper)
FLASH_MODEL=glm-flash-experimental
FLASH_PROVIDER=grid

# Subagent model for retrieval reasoning
SUBAGENT_MODEL=glm-latest
SUBAGENT_PROVIDER=grid

# API key for Grid (default synthesis provider)
# Get your key from your Grid account
GRID_API_KEY=your-grid-api-key-here

# -----------------------------------------------------------------------------
# RERANKING CONFIGURATION
# -----------------------------------------------------------------------------

# Reranker type: 'local-cross-encoder' | 'cross-encoder'
# - local-cross-encoder: Local server using SentenceTransformers (default, recommended)
# - cross-encoder: HuggingFace Inference API cross-encoder
# Both throw errors if the service is unavailable — no silent degradation.
RERANKER_TYPE=local-cross-encoder

# Local reranker server URL (used when RERANKER_TYPE=local-cross-encoder)
# Start the server with: python scripts/reranker_server.py
LOCAL_RERANKER_URL=http://localhost:8003

# Cross-encoder model name (for both local and HuggingFace)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# Note: cross-encoder type uses HUGGINGFACE_API_KEY (defined above in EMBEDDING section)

# -----------------------------------------------------------------------------
# PDF EXTRACTION SERVICE
# -----------------------------------------------------------------------------

# URL for the PyMuPDF PDF extraction server
# Default: http://localhost:8001
PDF_EXTRACTOR_URL=http://localhost:8001

# Vision API for image description in PDFs
# Uses Grid API at https://grid.ai.juspay.net/v1
VISION_BASE_URL=https://grid.ai.juspay.net/v1
VISION_MODEL=kimi-latest
# GRID_API_KEY is used for vision API authentication

# -----------------------------------------------------------------------------
# DATA STORAGE
# -----------------------------------------------------------------------------

# Directory to store indexed documents and embeddings
DATA_DIR=./data

# Directory for logs
LOG_DIR=./logs

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION (for API mode)
# -----------------------------------------------------------------------------

# Server port
PORT=3000

# Server host
HOST=localhost

# -----------------------------------------------------------------------------
# ADVANCED CONFIGURATION
# -----------------------------------------------------------------------------

# Number of parallel subagents (default: 4)
# SUBAGENT_COUNT=4

# Maximum multi-hop iterations (default: 3)
# MAX_HOPS=3

# Chunk size in tokens (default: 512)
# CHUNK_SIZE=512

# Chunk overlap in tokens (default: 50)
# CHUNK_OVERLAP=50

# RRF constant K (default: 60)
# RRF_K=60

# Top K candidates for reranking (default: 50)
# TOP_K_CANDIDATES=50