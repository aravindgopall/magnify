# =============================================================================
# Hybrid Search Agent - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# EMBEDDING MODEL CONFIGURATION
# -----------------------------------------------------------------------------

# Embedding provider type: 'bge-m3' | 'local-bge-m3' | 'openai' | 'mock'
EMBEDDING_PROVIDER=bge-m3

# HuggingFace API key (optional for BGE-M3, but recommended for higher rate limits)
# Get your key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY="key"

# Alternative: Local BGE-M3 server URL (if running locally)
# LOCAL_BGE_M3_URL=http://localhost:8000/embed

# Alternative: OpenAI configuration (if using OpenAI embeddings)
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1536

# -----------------------------------------------------------------------------
# SYNTHESIS MODEL CONFIGURATION (for answer generation)
# -----------------------------------------------------------------------------

# The synthesis model is configured via ~/.pi/agent/models.json
# By default, uses 'grid' provider with 'glm-latest' model
# 
# To use a different model, edit ~/.pi/agent/models.json:
# {
#   "providers": {
#     "openai": {
#       "models": {
#         "gpt-4o": { ... }
#       }
#     }
#   }
# }
# 
# Then update the model in src/agent/hybrid-search-agent.ts:
# const model = modelRegistry.find('openai', 'gpt-4o');

# API key for Grid (default synthesis provider)
# Get your key from your Grid account
GRID_API_KEY="key"

# -----------------------------------------------------------------------------
# RERANKING CONFIGURATION (optional)
# -----------------------------------------------------------------------------

# Reranker type: 'simple' | 'llm' | 'cohere'
RERANKER_TYPE=simple

# Cohere API key (if using Cohere reranker)
# COHERE_API_KEY=

# -----------------------------------------------------------------------------
# DATA STORAGE
# -----------------------------------------------------------------------------

# Directory to store indexed documents and embeddings
DATA_DIR=./data

# Directory for logs
LOG_DIR=./logs

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION (for API mode)
# -----------------------------------------------------------------------------

# Server port
PORT=3000

# Server host
HOST=localhost

# -----------------------------------------------------------------------------
# ADVANCED CONFIGURATION
# -----------------------------------------------------------------------------

# Number of parallel subagents (default: 4)
# SUBAGENT_COUNT=4

# Maximum multi-hop iterations (default: 3)
# MAX_HOPS=3

# Chunk size in tokens (default: 512)
# CHUNK_SIZE=512

# Chunk overlap in tokens (default: 50)
# CHUNK_OVERLAP=50

# RRF constant K (default: 60)
# RRF_K=60

# Top K candidates for reranking (default: 50)
# TOP_K_CANDIDATES=50