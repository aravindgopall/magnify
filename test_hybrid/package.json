{
  "name": "hybrid-search-agent",
  "version": "1.0.0",
  "description": "Multi-hop hybrid search system with dual indexing, RRF fusion, and parallel sub-agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx src/cli/ingest.ts",
    "query": "tsx src/cli/query.ts"
  },
  "keywords": [
    "hybrid-search",
    "rag",
    "bm25",
    "vector-search",
    "rrf",
    "multi-hop",
    "agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.62.0",
    "@mariozechner/pi-ai": "^0.62.0",
    "@mariozechner/pi-coding-agent": "^0.62.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "flexsearch": "^0.8.212",
    "form-data": "^4.0.5",
    "fuse.js": "^7.0.0",
    "node-fetch": "^3.3.2",
    "stopword": "^3.1.5",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
